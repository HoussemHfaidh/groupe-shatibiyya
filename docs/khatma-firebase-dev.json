{
  "khatma": {
    "groups": {
      "$group": {
        ".read": "$group === 'login-test-group1' || $group === 'login-test-group2' || $group === 'login-sandbox-group1' || $group === 'login-sandbox-group2'",
        ".write": "$group === 'login-test-group1' || $group === 'login-test-group2' || $group === 'login-sandbox-group1' || $group === 'login-sandbox-group2'"
      }
    },
    "catalogs": {
      "$environment": {
        ".read": "$environment === 'login-test' || $environment === 'login-sandbox'",
        ".write": "$environment === 'login-test' || $environment === 'login-sandbox'"
      }
    }
  }
}
